# Obligatorias
DATABASE_URL=postgresql://usuario:clave@host:5432/pura_suerte
PUBLIC_URL=https://tu-dominio.com

# Opcionales
BRAND_NAME=Pura Suerte
DATABASE_SSL=false
GOOGLE_CLIENT_ID=            # activa "Continuar con Google"
RESEND_API_KEY=              # envía los enlaces de acceso por correo
MAIL_FROM=Pura Suerte <hola@tu-dominio.com>
ALLOW_DEV_LOGIN=false       # true = muestra el enlace de acceso en pantalla (solo pruebas internas, sin Resend)
PAYMENTS_MODE=off            # off = tienda sin ventas; demo = acredita sin cobrar (solo pruebas)
PORT=3000
